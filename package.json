{
  "name": "dsh-lean",
  "version": "0.8.0",
  "description": "DeepSeek bills peak hours at 2x, and peak is 09-12 and 14-18 Beijing time. npx dsh-lean audit shows what your session paid and what it costs off-peak. DeepSeek 峰时按 2 倍计费，峰时正好是上班时间。",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./index.mjs"
  },
  "main": "index.mjs",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "files": [
    "assets",
    "bin",
    "lib",
    "index.mjs",
    "cordis.patch.yml",
    "README.md",
    "README.zh-CN.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "bench": "node scripts/run-bench.mjs bench/task-01",
    "test": "node test/patch.test.mjs"
  },
  "keywords": [
    "agent-preset",
    "cost-optimization",
    "deepseek",
    "deepseek-harness",
    "deepseek-pricing",
    "dsh",
    "dsh-plugin",
    "dsh-plugins",
    "llm",
    "off-peak",
    "peak-pricing",
    "prompt-cache",
    "token-cost"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sjh9714/dsh-lean.git"
  },
  "homepage": "https://github.com/sjh9714/dsh-lean#readme",
  "bugs": {
    "url": "https://github.com/sjh9714/dsh-lean/issues"
  },
  "bin": {
    "dsh-lean": "./bin/dsh-lean.mjs"
  }
}
