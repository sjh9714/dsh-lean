{
  "name": "dsh-lean",
  "version": "0.7.0",
  "description": "dsh sends 8,246 tokens before it reads your prompt and 3,700 are tools you never call. Audit your own session, then cut the prefix 53%. dsh 在读到你的提示词前已发出 8,246 个 token。",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./index.mjs"
  },
  "main": "index.mjs",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "files": [
    "assets",
    "bin",
    "lib",
    "index.mjs",
    "cordis.patch.yml",
    "README.md",
    "README.zh-CN.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "bench": "node scripts/run-bench.mjs bench/task-01",
    "test": "node test/patch.test.mjs"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "dsh-plugins",
    "deepseek-harness",
    "deepseek",
    "agent-preset",
    "token-cost",
    "prompt-cache",
    "cost-optimization",
    "llm"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sjh9714/dsh-lean.git"
  },
  "homepage": "https://github.com/sjh9714/dsh-lean#readme",
  "bugs": {
    "url": "https://github.com/sjh9714/dsh-lean/issues"
  },
  "bin": {
    "dsh-lean": "./bin/dsh-lean.mjs"
  }
}
